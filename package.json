{
  "name": "tinysaver",
  "version": "0.3.0",
  "description": "Modern replacement of file-saver.js.",
  "keywords": [
    "download",
    "file",
    "file-saver",
    "save-as"
  ],
  "homepage": "https://github.com/ntnyq/tinysaver#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/tinysaver/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": "ntnyq/tinysaver",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "playground": "pnpm -C playground run dev",
    "playground:build": "pnpm -C playground run build",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s lint typecheck test",
    "release:check:full": "run-s format:check lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "test:browser": "run-s build test:browser:run",
    "test:browser:run": "playwright test",
    "typecheck": "run-p typecheck:lib typecheck:playground",
    "typecheck:lib": "tsc --noEmit",
    "typecheck:playground": "pnpm -C playground run typecheck"
  },
  "devDependencies": {
    "@ntnyq/tsconfig": "^3.1.0",
    "@ntnyq/utils": "^0.21.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "bumpp": "^12.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "browserslist": [
    "Chrome >= 87",
    "Edge >= 88",
    "Firefox >= 78",
    "Safari >= 14"
  ],
  "packageManager": "pnpm@11.18.0"
}
